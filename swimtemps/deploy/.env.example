# Copy to /opt/swimtemps/.env on the VPS. Never commit the real one.

# --- Site ---------------------------------------------------------------
ENV=production
DOMAIN=swimtemps.example
SITE_URL=https://swimtemps.example
# The image the deploy workflow pushes.
IMAGE=ghcr.io/alittlesliceoftom/swimtemps:latest

# --- Database: Supabase Postgres -------------------------------------------
# Project settings -> Database -> Connect -> Session pooler (port 5432). It
# works over IPv4, which the containers' default Docker network is limited to.
# The direct connection (db.PROJECTREF.supabase.co) is IPv6-only: usable only
# after enabling IPv6 for Docker and this compose network, so it is not the default.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# --- Auth: Supabase Auth with Google -------------------------------------
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_ANON_KEY=
# Only for a project still on legacy HS256 JWT secrets. Leave empty to verify
# tokens against the project's JWKS (asymmetric signing keys).
SUPABASE_JWT_SECRET=

# Never set in production: the app refuses to start with it.
DEV_LOGIN=
