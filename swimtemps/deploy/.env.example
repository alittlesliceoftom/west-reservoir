# Copy to /opt/swimtemps/.env on the VPS. Never commit the real one.

# --- Site ---------------------------------------------------------------
ENV=production
DOMAIN=swimtemps.example
SITE_URL=https://swimtemps.example
# The image the deploy workflow pushes.
IMAGE=ghcr.io/alittlesliceoftom/swimtemps:latest

# --- Database: Supabase Postgres -------------------------------------------
# Project settings -> Database -> Connection string. The direct connection is
# IPv6-only, which Hetzner supports; use the pooler (session mode) for IPv4.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres

# --- Auth: Supabase Auth with Google -------------------------------------
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_ANON_KEY=
# Only for a project still on legacy HS256 JWT secrets. Leave empty to verify
# tokens against the project's JWKS (asymmetric signing keys).
SUPABASE_JWT_SECRET=

# Never set in production: the app refuses to start with it.
DEV_LOGIN=
